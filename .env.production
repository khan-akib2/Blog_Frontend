# ─────────────────────────────────────────────
# FRONTEND — Production Environment
# Deploy target: Vercel / any Next.js host
# ─────────────────────────────────────────────

# Your deployed backend URL (no trailing slash)
# e.g. https://api.yourdomain.com/api  OR  https://bloghub-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api

# Google OAuth Client ID (same as dev — it's public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=232347634332-fomimlrp6bbgns35mb9q96ocoq1hi1do.apps.googleusercontent.com

# Used by Next.js ISR revalidation webhook (must match REVALIDATE_SECRET on backend)
REVALIDATE_SECRET=bloghub_revalidate_prod_2026
